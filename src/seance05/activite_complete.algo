Algorithme Menu_didactique
Début
  Répéter
    Répéter
      Ecrire("=========================================")
      Ecrire("BANC D'ESSAI ÉLECTRIQUE (LOI D'OHM)   ")
      Ecrire("==========================================")
      Ecrire("1 : Lancer le test interactif (U = R * I)")
      Ecrire("2 : Arbitrage de priorité réseau (Duel)")
      Ecrire("3 : Déstockage sécurisé (Jeu de Nim)")
      Ecrire("0 : Quitter l'application")
      Ecrire("------------------------------------------")

      Ecrire("Votre Choix ? ")
      Lire(choix)
    Jusqu'à 0 ≤ choix ≤ 3

    
    Si choix = 1 Alors
      //--- Choix 1 ---
      r ← Alea(1, 20)
      i ← Alea(1, 10)
      essai ← 0
      Répéter
        essai ← essai + 1
        Ecrire("Essai n°", essai)
        Ecrire("R =", r, "Ω, I =", i, "A - Calculer le voltage U = R * I")
        Lire(u)
        Si u ≠ r * i Alors
          Ecrire("Incorrect !")
        Fin Si
      Jusqu'à essai = 3 ou r * i = u
      Si u = r * i Alors
        Ecrire("Correct !")
      Sinon
        Ecrire("La bonne réponse est :", r * i, "V")
      Fin Si

    Sinon Si choix = 2 Alors
      //--- Choix 2 ---
      n1 ← 0
      n2 ← 0
      manche ← 0
      Tant Que n1 ≠ 10 et n2 ≠ 10 Faire
        manche ← manche + 1
        r1 ← Alea(1, 6)
        r2 ← Alea(1, 6)
        Ecrire("Manche", manche)
        Ecrire("Routeur 1 :", r1, "- Routeur 2 :", r2)
        Si r1 > r2 Alors
          n1 ← n1 + 1
          Ecrire("Routeur 1 gagne")
        sinon si r1 < r2 Alors
          n2 ← n2 + 1
          Ecrire("Routeur 2 gagne")
        Fin Si
        Ecrire("n1 =", n1, "- n2 =", n2)
      Fin Tant Que
      Si n1 > n2 Alors
        Ecrire("Le routeur 1 remporte la priorité")
      Sinon
        Ecrire("Le routeur 2 remporte la priorité")
      Fin Si
      
    Sinon Si choix = 3 Alors
      //--- Choix 3 ---
      comp ← 16
      j ← 0
      Répéter
        Ecrire("Nombre de composants :", comp)
        Ecrire("Joueur ", j+1)
        Répéter
          Ecrire("Nombre à retirer ? ")
          Lire(nbc)
        Jusqu'à 1 ≤ nbc ≤ (3 + comp - abs(3 - comp)) div 2
        comp ← comp - nbc
        Si comp > 0 Alors
          j ← (j + 1) mod 2
        Fin Si
      Jusqu'à comp = 0
      Ecrire("Le joueur", j+1, "a gagné")
    Fin Si
  Jusqu'à choix = 0
Fin

TDO
Objet : Type/Nature
choix, r, i, essai, u, n1, n2, manche, r1, r2, comp, j, nbc : entier

